// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================
// ENUM types 
// =============================================

enum UserPresenceStatus {
  ONLINE
  OFFLINE
  AWAY
  DO_NOT_DISTURB
}

enum UserCreationStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum WorkspaceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MemberStatus {
  ONLINE
  OFFLINE
  IDLE
}

enum RoleType {
  ADMIN
  OWNER
  MEMBER
}

enum ChannelType {
  PUBLIC
  PRIVATE
  DM
  GROUP_DM
}

enum NotificationType {
  DM_RECEIVED
  MESSAGE_MENTION
  CHANNEL_MENTION
  HERE_MENTION
  THREAD_REPLY
  TASK_ASSIGNED
  INVITE_RECEIVED
}

//Used to identify from where the notification is pushed.
enum EntityType {
  TASK
  MESSAGE
  INVITATION
}

enum AttachStatus {
  PENDING
  READY
}

enum CallStatus {
    RINGING
    ACTIVE
    ENDED
    MISSED
}

enum ParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
  LEFT
}

// =============================================
// MODELS
// =============================================

model User {
  id                    String   @id @default(uuid())
  name                  String?
  email                 String   @unique
  password              String   // Not nullable - password is required for all users
  is_email_verified     Boolean  @default(false)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  user_presence_status  UserPresenceStatus? @default(OFFLINE)
  user_creation_status  UserCreationStatus? @default(ACTIVE)

  workspace_members WorkspaceMember[]

  @@map("users")
}

model Workspace {
  id          String          @id @default(uuid())
  name        String
  description String?
  slug        String @unique
  created_at  DateTime?
  updated_at  DateTime @updatedAt
  status      WorkspaceStatus @default(ACTIVE)

  members     WorkspaceMember[]
  channels    Channel[]
  attachments Attachment[]

  @@map("workspace")
}

model WorkspaceMember {
  id             String     @id @default(uuid())
  user           User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id        String
  workspace      Workspace  @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  workspace_id   String
  role           RoleType @default(MEMBER)
  display_name   String?
  member_status  MemberStatus?
  joined_at      DateTime?
  channel_members ChannelMember[]
  messages        Message[]
  notifications   Notification[]
  attachments     Attachment[]      @relation("UploadedAttachments")
  call_sessions   CallSession[]     @relation("StartedCallSessions")
  call_participations CallParticipant[]

  @@unique([user_id, workspace_id])
  @@map("workspace_members")
}

model Channel {
  id            String      @id @default(uuid())
  name          String?
  channel_type  ChannelType @default(PUBLIC)
  is_archived   Boolean     @default(false)
  created_at    DateTime    @default(now())
  workspace_id  String
  workspace     Workspace   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  members       ChannelMember[]
  messages      Message[]
  call_sessions CallSession[]

  @@map("channel")
}

model ChannelMember {
  id                   String          @id @default(uuid())
  channel              Channel         @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  channel_id           String
  workspace_member     WorkspaceMember @relation(fields: [workspace_member_id], references: [id], onDelete: Cascade)
  workspace_member_id  String

  @@unique([channel_id, workspace_member_id])
  @@map("channel_member")
}

model Message {
  id                String          @id @default(uuid())
  channel           Channel         @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  channel_id        String
  sender            WorkspaceMember @relation(fields: [sender_id], references: [id], onDelete: Cascade)
  sender_id         String
  content           String?
  parent_message    Message?        @relation("MessageReplies", fields: [parent_msg_id], references: [id], onDelete: SetNull)
  parent_msg_id     String?
  replies           Message[]       @relation("MessageReplies")
  is_edited         Boolean         @default(false)
  is_deleted        Boolean         @default(false)
  created_at        DateTime?
  edited_at         DateTime?

  @@map("messages")
}

model Notification {
  id                String           @id @default(uuid())
  workspace_member  WorkspaceMember  @relation(fields: [workspace_member_id], references: [id], onDelete: Cascade)
  workspace_member_id String
  entity_type       EntityType
  entity_id         String?
  notification_type NotificationType
  created_at        DateTime?        @default(now())
  is_read           Boolean          @default(false)

  @@map("notifications")
  @@index([workspace_member_id,id,created_at])
}

model Attachment{
  id  String @id @default(uuid())
  filename String
  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  uploader_member_id String
  uploader     WorkspaceMember @relation("UploadedAttachments", fields: [uploader_member_id], references: [id], onDelete: NoAction)
  message_id String?
  storage_key String @unique
  mime String
  size Int
  attach_status AttachStatus
  created_at DateTime @default(now())

  @@map("attachment")
  @@index([workspace_id, attach_status, created_at])
  @@index([message_id])
}

model CallSession {
  id           String          @id @default(uuid())
  channel      Channel         @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  channel_id   String
  starter      WorkspaceMember @relation("StartedCallSessions", fields: [starter_id], references: [id], onDelete: Cascade)
  starter_id   String
  status       CallStatus
  started_at   DateTime        @default(now())
  ended_at     DateTime?

  participants CallParticipant[]

  @@map("call_session")
  @@index([channel_id, started_at])
}

model CallParticipant {
  id              String          @id @default(uuid())
  call_session    CallSession     @relation(fields: [call_session_id], references: [id], onDelete: Cascade)
  call_session_id String
  member          WorkspaceMember @relation(fields: [member_id], references: [id], onDelete: Cascade)
  member_id       String
  status          ParticipantStatus 
  joined_at       DateTime        @default(now())
  left_at         DateTime?

  @@unique([call_session_id, member_id])
  @@map("call_participant")
}